# Copy this file to backend/.env and adjust as needed.

# Points at the Postgres container started by the root docker-compose.yml.
# Phase 1: backend runs on host, so "localhost" is correct here (not a
# Docker service hostname like "db").
DATABASE_URL=postgresql+psycopg2://abm_user:abm_password@localhost:5432/ai_business_manager

# Reserved for Phase 2 (authentication). Not used yet.
SECRET_KEY=change_me_in_phase_2
